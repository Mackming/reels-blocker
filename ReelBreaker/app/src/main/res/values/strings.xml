    <string name="app_name">ReelBreaker</string>
    <string name="accessibility_label">ReelBreaker — Reels Blocker &amp; Counter</string>

    <!-- Onboarding -->
    <string name="onboard_headline">Reels are slot machines.\nYour thumb is pulling the lever.</string>
    <string name="onboard_sub">ReelBreaker counts every swipe, detects when you lose control, and puts neuroscience-based friction between the urge and the feed.</string>
    <string name="onboard_step1">1 · Counting needs the Accessibility switch — it\'s the only OS-level way to see swipes without root. Your data never leaves the phone.</string>
    <string name="onboard_step2">2 · Pick your feeds: Instagram Reels, YouTube Shorts, TikTok…</string>
    <string name="onboard_step3">3 · Choose your protection level — from pure awareness to hard blocking.</string>
    <string name="onboard_grant_accessibility">Grant accessibility access</string>
    <string name="onboard_enable_blocker">Turn blocker ON</string>
    <string name="onboard_finish">Start breaking the loop</string>

