<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/big_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/accent2"
            android:textSize="84sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/budget_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_lo"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/streak_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_hi"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/session_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@color/surface"
            android:padding="14dp"
            android:textColor="@color/text_hi"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/blocked_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/warn"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/brain_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/state_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_lo"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dash_7day"
            android:textColor="@color/text_lo"
            android:textSize="13sp" />

        <com.reelbreaker.ui.dashboard.HistoryView
            android:id="@+id/history_chart"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:background="@color/surface" />

        <Button
            android:id="@+id/arm_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/settings_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dash_settings" />

    </LinearLayout>
</ScrollView>
