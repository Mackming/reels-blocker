<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/overlay_bg"
    android:gravity="center_horizontal"
    android:padding="28dp">

    <TextView
        android:id="@+id/sb_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_lo"
        android:textSize="15sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/sb_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="@color/text_hi"
        android:textSize="19sp"
        android:textStyle="bold"
        android:gravity="center" />

    <GridLayout
        android:id="@+id/sb_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:columnCount="3" />

    <TextView
        android:id="@+id/sb_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/accent2"
        android:textSize="15sp"
        android:gravity="center" />

</LinearLayout>
