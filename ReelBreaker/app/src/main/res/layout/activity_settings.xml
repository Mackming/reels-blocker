<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_card_elevated"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Settings"
                android:textColor="@color/text_hi"
                android:textSize="18sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/set_save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Card 1: Protection Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="PROTECTION LEVEL"
                android:textColor="@color/text_lo"
                android:textSize="10sp" />

            <Spinner
                android:id="@+id/mode_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:popupBackground="@color/surface2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:text="Adaptive friction triggers based on swipe acceleration, circadian bedtime, and session budgets."
                android:textColor="@color/text_med"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Card 2: Budget & Session Caps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="BUDGETS &amp; CAPS"
                android:textColor="@color/text_lo"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/set_daily_budget"
                android:textColor="@color/text_hi"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/budget_input"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:inputType="number"
                android:textColor="@color/text_hi"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/set_session_cap"
                android:textColor="@color/text_hi"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/cap_input"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:inputType="number"
                android:textColor="@color/text_hi"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/set_commitment"
                android:textColor="@color/text_hi"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/commit_input"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:hint="e.g. 15 (blank = no rule)"
                android:inputType="number"
                android:textColor="@color/text_hi"
                android:textColorHint="@color/text_lo"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Card 3: Bedtime Circadian Window -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="CIRCADIAN SLEEP WINDOW"
                android:textColor="@color/text_lo"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="Start / End times (HH:mm). Friction tightens 50% when scrolling in dark environments during bedtime."
                android:textColor="@color/text_med"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/sleep_start_input"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:fontFamily="sans-serif"
                    android:hint="22:30"
                    android:inputType="time"
                    android:textColor="@color/text_hi"
                    android:textColorHint="@color/text_lo"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/sleep_end_input"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:fontFamily="sans-serif"
                    android:hint="05:00"
                    android:inputType="time"
                    android:textColor="@color/text_hi"
                    android:textColorHint="@color/text_lo"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 4: Implementation Intention & Replacement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="REPLACEMENT HABIT (INTENTION)"
                android:textColor="@color/text_lo"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/replacement_input"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:hint="e.g. Read 10 pages of my book"
                android:inputType="text"
                android:textColor="@color/text_hi"
                android:textColorHint="@color/text_lo"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/set_replacement_app"
                android:textColor="@color/text_hi"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/replacement_app_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:popupBackground="@color/surface2" />
        </LinearLayout>

        <!-- Card 5: Target Feeds -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="PROTECTED FEEDS"
                android:textColor="@color/text_lo"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/app_checks2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Card 6: Background Keep-Alive / Battery Exemption -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="BACKGROUND PERSISTENCE &amp; BATTERY"
                android:textColor="@color/text_lo"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="Prevents aggressive OEM battery managers (Samsung OneUI, Xiaomi HyperOS, OnePlus) from silently killing the accessibility blocker."
                android:textColor="@color/text_med"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_battery_opt"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_ghost"
                android:fontFamily="sans-serif-medium"
                android:text="Exempt from Battery Optimization"
                android:textAllCaps="false"
                android:textColor="@color/text_hi"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
